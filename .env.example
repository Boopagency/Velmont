# ---- Public (safe in the browser; baked into the build) ----
# Final HTTPS origin of the site, without trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.grupovelmont.com
# Supabase project URL and the anon/publishable key (never the service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" records contact-form submissions as leads (the privacy page text follows it).
NEXT_PUBLIC_LEAD_CAPTURE=false
# Optional Cloudflare Turnstile site key for the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server only (Vercel Functions). Never prefix with NEXT_PUBLIC_. ----
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters: `openssl rand -hex 32`
RATE_LIMIT_SALT=
# Optional, pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Vercel → Project → Settings → Git → Deploy Hooks, branch `main` (production).
VERCEL_DEPLOY_HOOK_URL=
